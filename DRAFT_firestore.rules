rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Phase 4: Validation Blueprints
    function isValidUser(data) {
      return data.userName is string && data.userName.size() > 0 && data.userName.size() <= 50
        && data.profileImage is string && data.profileImage.size() <= 500;
    }

    function isValidTransaction(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.amount is number
        && data.category in ['food', 'transport', 'salary', 'other']
        && data.userId == request.auth.uid
        && data.createdAt == request.time;
    }

    function isValidGoal(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.target is number && data.target >= 0
        && data.current is number && data.current >= 0
        && data.iconType is string && data.iconType.size() <= 50
        && data.color is string && data.color.size() <= 50
        && data.userId == request.auth.uid;
    }

    // Rules for Collections
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['userName', 'profileImage']);

      match /private/info {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().email == request.auth.token.email;
      }

      match /transactions/{transactionId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(incoming());
        allow update: if false; // Transactions are immutable in this spec
        allow delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGoal(incoming());
        allow update: if isOwner(userId) && (
          // Action: Update Progress
          (incoming().diff(existing()).affectedKeys().hasOnly(['current'])) ||
          // Action: Rename/Settings
          (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'target', 'iconType', 'color']))
        ) && isValidGoal(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
